# Thieme preset (ADR 0015). Independent prototype, not affiliated with Thieme.
CROSSREF_PREFIX=10.1055
CROSSREF_FROM_PUB_DATE=2024-01-01
# Europe PMC subjects and matching-only open access full text (ADR 0024)
EUROPEPMC_ENABLED=true
# MCP server (ADR 0025): the publisher named in the notice, and where card links point
# (the reference landing app, SM-11; set your hosted landing page in a deployment)
PUBLISHER_NAME=Thieme
LANDING_BASE_URL=http://localhost:3000
# Journal-level subjects for articles without MeSH or keywords (ADR 0004)
JOURNAL_SUBJECTS_FILE=presets/thieme.subjects.json
