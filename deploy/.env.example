# Copy to .env and fill in (docs/SELF-HOSTING.md). Keep .env readable by its owner only.

# --- Required -------------------------------------------------------------------------
# The hostname readers and AI clients use; point its DNS A/AAAA record at this host.
PUBLIC_HOST=mcp.example.org
# Contact for Crossref's polite pool and for Let's Encrypt expiry mail.
CROSSREF_MAILTO=ops@example.org
ACME_EMAIL=ops@example.org
# The release to run; see the GitHub releases page. Pin it, upgrade on purpose.
SCHOLARLY_VERSION=0.2.1

# --- Store: pick one block -----------------------------------------------------------
# A) SQLite on this host (default): nothing more to set.
STORE=sqlite

# B) The bundled Postgres: uncomment, and choose three long random passwords before the
#    first start (they are written into the database once).
# STORE=postgres
# COMPOSE_PROFILES=postgres
# PG_SUPERUSER_PASSWORD=change-me
# PG_INGEST_PASSWORD=change-me
# PG_SERVER_PASSWORD=change-me
# DATABASE_URL=postgres://scholarly_server:${PG_SERVER_PASSWORD}@postgres:5432/scholarly
# ADMIN_DATABASE_URL=postgres://scholarly_ingest:${PG_INGEST_PASSWORD}@postgres:5432/scholarly

# C) Your own Postgres (pgvector 0.8+, pg_trgm): create the roles once as the guide shows.
# STORE=postgres
# DATABASE_URL=postgres://scholarly_server:PASSWORD@db.internal:5432/scholarly?sslmode=require
# ADMIN_DATABASE_URL=postgres://scholarly_ingest:PASSWORD@db.internal:5432/scholarly?sslmode=require

# --- Optional -------------------------------------------------------------------------
# Behind Cloudflare Tunnel or a load balancer (SELF-HOSTING.md#cloudflare):
# COMPOSE_PROFILES=cloudflare
# CLOUDFLARE_TUNNEL_TOKEN=
# SITE_ADDRESS=:8080
# TRUSTED_PROXIES=private_ranges
# BIND_ADDRESS=127.0.0.1

# Usage export to your billing system (docs/guides/operating-the-server.md#usage-metering).
# METER_WEBHOOK_URL=https://billing.example.org/hooks/mcp-usage
# METER_WEBHOOK_SECRET=

# Tool calls per client a minute, search threads on SQLite, OpenTelemetry traces, log level.
# RATE_LIMIT_PER_MINUTE=60
# SQLITE_SEARCH_WORKERS=2
# OTEL_EXPORTER_OTLP_ENDPOINT=
# LOG_LEVEL=info
