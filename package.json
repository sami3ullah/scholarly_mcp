{
  "name": "scholarly-mcp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "pnpm build:packages && vitest run",
    "test:coverage": "pnpm build:packages && vitest run --coverage",
    "lint": "pnpm build:packages && eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise packages apps --config .dependency-cruiser.cjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm depcruise && pnpm test:coverage",
    "prepare": "husky",
    "build:packages": "turbo run build --output-logs=errors-only --filter=!@scholarly-mcp/landing",
    "ingest": "pnpm build:packages && node --env-file-if-exists=.env apps/ingest/dist/main.js",
    "eval": "pnpm build:packages && node --env-file-if-exists=.env apps/eval/dist/main.js",
    "landing": "pnpm build:packages && pnpm --filter @scholarly-mcp/landing"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.4",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autocannon": "8.0.0",
    "dependency-cruiser": "^18.7.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
